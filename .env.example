# App Settings
PROJECT_NAME="Mutual Aid Ride Sharing"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
